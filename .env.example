# Copy to .env and fill in. Every setting is documented in backend/app/config.py.

# ---- core ----
ENVIRONMENT=development            # set to production for go-live (enforces real secrets)
JWT_SECRET=replace-with-64-random-characters
INBOUND_WEBHOOK_SECRET=replace-with-a-random-string
SEED_DEMO_DATA=true                # false for production; demo tickets can also be purged in Settings

# ---- AI (free options first; leave keys blank to run on the built-in rules engine) ----
AI_PROVIDER=groq                   # groq | gemini | anthropic | openai | rules
GROQ_API_KEY=                      # free, no card: https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=                    # free, no card: https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
ANTHROPIC_API_KEY=                 # paid options
OPENAI_API_KEY=

# ---- rollout controls ----
AUTOMATION_MODE=live               # shadow = parallel run (AI drafts everything, sends nothing)
AUTO_RESOLVE_INTENTS=order_status,product_availability,store_policy
AUTO_RESOLVE_MIN_CONFIDENCE=0.80
REFUND_AUTO_APPROVE_LIMIT=0        # $; 0 = every refund needs a supervisor

# ---- Beacon systems (mock = built-in demo data) ----
ORDER_CONNECTOR=mock               # mock | magento
INVENTORY_CONNECTOR=mock           # mock | magento
MAGENTO_BASE_URL=
MAGENTO_ACCESS_TOKEN=
CRM_CONNECTOR=mock                 # mock | http
CRM_BASE_URL=
CRM_API_KEY=

# ---- outbound ----
EMAIL_TRANSPORT=console            # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Beacon Lighting Support <support@beaconlighting.com.au>
SMS_TRANSPORT=console              # console | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- inbound email via mailbox polling (alternative to the webhook) ----
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
